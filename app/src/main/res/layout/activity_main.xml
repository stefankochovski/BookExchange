<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="@string/login_title"
        android:textColor="#333333"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- Полиња за мејл и лозинка -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/email_hint"
        android:inputType="textEmailAddress"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/password_hint"
        android:inputType="textPassword"
        android:padding="12dp" />

    <!-- Копче за стандардна најава -->
    <Button
        android:id="@+id/btnLoginEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#4CAF50"
        android:text="@string/btn_login"
        android:textColor="@android:color/white" />

    <!-- Копче за регистрација -->
    <Button
        android:id="@+id/btnRegisterEmail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:backgroundTint="#9E9E9E"
        android:text="@string/btn_register"
        android:textColor="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="или" />

    <!-- Google Login -->
    <Button
        android:id="@+id/btnLoginGoogle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#EA4335"
        android:text="@string/login_google"
        android:textColor="@android:color/white" />

    <!-- Facebook Login -->
    <Button
        android:id="@+id/btnLoginFacebook"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:backgroundTint="#3B5998"
        android:text="@string/login_facebook"
        android:textColor="@android:color/white" />

    <!-- Anonymous Login -->
    <Button
        android:id="@+id/btnAnonymous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#607D8B"
        android:text="@string/login_anonymous"
        android:textColor="@android:color/white" />

</LinearLayout>