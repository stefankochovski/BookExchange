<?xml version="1.0" encoding="utf-8"?>
<!-- res/drawable/bg_input_focused.xml -->
<!-- Користи го ова за EditText кои треба golden border при focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_navy" />
            <stroke android:width="1dp" android:color="@color/gold" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_navy" />
            <stroke android:width="1dp" android:color="@color/border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>